<?xml version="1.0" encoding="utf-8"?>
<!--
  NØTUNE Data Extraction Rules (Android 12+ / API 31+).
  Isolates cloud-backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="notune_secure_prefs.xml" />
        <exclude
            domain="file"
            path="datastore/secure_tokens.preferences_pb" />
        <exclude
            domain="file"
            path="exoplayer" />
        <exclude
            domain="file"
            path="download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <exclude
            domain="database"
            path="song.db" />
    </cloud-backup>

    <device-transfer>
        <exclude
            domain="sharedpref"
            path="notune_secure_prefs.xml" />
        <exclude
            domain="file"
            path="datastore/secure_tokens.preferences_pb" />
        <exclude
            domain="file"
            path="exoplayer" />
        <exclude
            domain="file"
            path="download" />
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <exclude
            domain="database"
            path="song.db" />
    </device-transfer>
</data-extraction-rules>