## local.properties.template
## Copy this file to local.properties and fill in your values.
## local.properties is git-ignored and must NEVER be committed to version control.

## Android SDK location (auto-generated by Android Studio)
# sdk.dir=/path/to/your/Android/Sdk

## --- Last.fm API ---
## Register at https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_SECRET=

## --- GitHub OAuth (for update checker) ---
## Create at https://github.com/settings/applications/new
GH_CLIENT_ID=
GH_CLIENT_SECRET=

## --- FlowNeuro (optional AI backend) ---
# FLOW_NEURO_BASE_URL=https://api.flowneuroengine.com
# FLOW_NEURO_API_KEY=
