# NØTUNE Cloud Platform Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO GIT - Copy this file to .env locally

# 1. Supabase PostgreSQL & Auth Config
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
DATABASE_URL=postgresql://postgres:your_db_password@db.your_supabase_project_ref.supabase.co:5432/postgres

# 2. JWT Authentication Secret
JWT_SECRET=your_jwt_signing_secret_min_32_chars

# 3. Cloudflare Workers & Workers AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# 4. Cloudflare R2 Storage (Media/Artwork Storage)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=notune-media

# 5. Remote AI Model Routing (Optional External Fallbacks)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

